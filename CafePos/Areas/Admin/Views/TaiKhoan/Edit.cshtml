@model CafePos.Models.User

@{
    ViewData["Title"] = "Cập nhật tài khoản";
    var fullName = ViewBag.FullName as string;
    bool isEmployee = Model.RoleId == 3 || Model.Employee != null;
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-header bg-warning text-dark py-3 rounded-top-4">
                    <h4 class="mb-0 fw-bold">
                        <i class="bi bi-pencil-square me-2"></i>Chỉnh Sửa Tài Khoản
                    </h4>
                </div>

                <div class="card-body p-4">
                    <form asp-action="Edit" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="UserId" />

                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3 small"></div>

                        <!-- Tên tài khoản -->
                        <div class="mb-3">
                            <label asp-for="Username" class="form-label fw-bold">Tên đăng nhập</label>
                            <input asp-for="Username" class="form-control rounded-3" placeholder="Nhập tên đăng nhập..." />
                            <span asp-validation-for="Username" class="text-danger small"></span>
                        </div>

                        <!-- Họ và tên nhân viên (Chỉ hiển thị nếu là Nhân viên RoleId = 3) -->
                        @if (isEmployee)
                        {
                            <div class="mb-3">
                                <label class="form-label fw-bold text-primary">
                                    <i class="bi bi-person-vcard me-1"></i>Họ và tên nhân viên
                                </label>
                                <input type="text" name="fullName" class="form-control rounded-3 border-primary"
                                       value="@fullName" placeholder="Nhập họ và tên nhân viên..." required />
                                <span class="text-danger small">@Html.ValidationMessage("FullName")</span>
                            </div>
                        }

                        <!-- Email -->
                        <div class="mb-3">
                            <label asp-for="Email" class="form-label fw-bold">Email</label>
                            <input asp-for="Email" class="form-control rounded-3" placeholder="Ví dụ: example@gmail.com" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <!-- Loại tài khoản (Chỉ đọc) -->
                        <div class="mb-3">
                            <label class="form-label fw-bold text-secondary">Loại tài khoản</label>
                            <input class="form-control bg-light rounded-3" value="@(Model.Role?.Name ?? "Nhân viên")" readonly />
                            <small class="text-muted">Loại tài khoản không được phép chỉnh sửa.</small>
                        </div>

                        <!-- Mật khẩu (Chỉ đọc) -->
                        <div class="mb-3">
                            <label class="form-label fw-bold text-secondary">Mật khẩu</label>
                            <input type="password" class="form-control bg-light rounded-3" value="******" readonly />
                            <small class="text-muted">Mật khẩu không được phép chỉnh sửa tại đây (dùng tính năng Đổi mật khẩu nếu cần).</small>
                        </div>

                        <!-- Trạng thái hoạt động -->
                        <div class="mb-4">
                            <label asp-for="TrangThai" class="form-label fw-bold">Trạng thái</label>
                            <select asp-for="TrangThai" class="form-select rounded-3" asp-items="ViewBag.TrangThais">
                                <option value="">-- Chọn trạng thái --</option>
                            </select>
                            <span asp-validation-for="TrangThai" class="text-danger small"></span>
                        </div>

                        <!-- Nút thao tác -->
                        <div class="d-flex gap-2 justify-content-end pt-2">
                            <a asp-action="Index" class="btn btn-outline-secondary px-4 rounded-pill">
                                <i class="bi bi-arrow-left me-1"></i> Quay lại
                            </a>
                            <button type="submit" class="btn btn-warning px-4 rounded-pill fw-bold text-dark">
                                <i class="bi bi-save me-1"></i> Cập nhật
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}