@model CafePos.Models.User

@{
    ViewData["Title"] = "Tạo tài khoản";
    var fullName = ViewBag.FullName as string;
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-header bg-primary text-white py-3 rounded-top-4">
                    <h4 class="mb-0 fw-bold">
                        <i class="bi bi-person-plus-fill me-2"></i>Thêm Tài Khoản Mới
                    </h4>
                </div>

                <div class="card-body p-4">
                    <form asp-action="Create" method="post">
                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3 small"></div>

                        <!-- Tên đăng nhập -->
                        <div class="mb-3">
                            <label asp-for="Username" class="form-label fw-bold">Tên đăng nhập</label>
                            <input asp-for="Username" class="form-control rounded-3" placeholder="Nhập tên đăng nhập..." autofocus />
                            <span asp-validation-for="Username" class="text-danger small"></span>
                        </div>

                        <!-- Mật khẩu -->
                        <div class="mb-3">
                            <label asp-for="PasswordHash" class="form-label fw-bold">Mật khẩu</label>
                            <input asp-for="PasswordHash" type="password" class="form-control rounded-3" placeholder="Nhập mật khẩu..." />
                            <span asp-validation-for="PasswordHash" class="text-danger small"></span>
                        </div>

                        <!-- Loại tài khoản -->
                        <div class="mb-3">
                            <label asp-for="RoleId" class="form-label fw-bold">Loại tài khoản</label>
                            <select asp-for="RoleId" id="roleSelect" asp-items="ViewBag.RoleId" class="form-select rounded-3">
                                <option value="">-- Chọn loại tài khoản --</option>
                            </select>
                            <span asp-validation-for="RoleId" class="text-danger small"></span>
                        </div>

                        <!-- Ô nhập Họ tên nhân viên (Hiện khi RoleId = 3) -->
                        <div class="mb-3 d-none" id="divFullName">
                            <label class="form-label fw-bold text-primary">
                                <i class="bi bi-person-vcard me-1"></i>Họ và tên nhân viên
                            </label>
                            <input type="text" name="fullName" id="fullNameInput" class="form-control rounded-3 border-primary"
                                   value="@fullName" placeholder="Nhập đầy đủ họ tên nhân viên..." />
                            <span class="text-danger small">@Html.ValidationMessage("FullName")</span>
                        </div>

                        <!-- Email -->
                        <div class="mb-3">
                            <label asp-for="Email" class="form-label fw-bold">Email (không bắt buộc)</label>
                            <input asp-for="Email" class="form-control rounded-3" placeholder="Ví dụ: example@gmail.com" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <!-- Trạng thái -->
                        <div class="mb-4">
                            <label asp-for="TrangThai" class="form-label fw-bold">Trạng thái</label>
                            <select asp-for="TrangThai" asp-items="ViewBag.TrangThais" class="form-select rounded-3">
                                <option value="">-- Chọn trạng thái --</option>
                            </select>
                            <span asp-validation-for="TrangThai" class="text-danger small"></span>
                        </div>

                        <div class="alert alert-info border-0 bg-info bg-opacity-10 rounded-3 text-dark mb-4">
                            <small>
                                <i class="bi bi-info-circle-fill text-info me-1"></i>
                                <strong>Lưu ý:</strong> Khi tạo tài khoản loại <strong>Nhân viên</strong>, hệ thống sẽ tự động tạo hồ sơ tương ứng trong bảng Quản lý nhân viên.
                            </small>
                        </div>

                        <!-- Nút thao tác -->
                        <div class="d-flex gap-2 justify-content-end pt-2">
                            <a asp-action="Index" class="btn btn-outline-secondary px-4 rounded-pill">
                                <i class="bi bi-arrow-left me-1"></i> Quay lại
                            </a>
                            <button type="submit" class="btn btn-primary px-4 rounded-pill fw-bold">
                                <i class="bi bi-save me-1"></i> Lưu tài khoản
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        document.addEventListener("DOMContentLoaded", function() {
            const roleSelect = document.getElementById("roleSelect");
            const divFullName = document.getElementById("divFullName");
            const fullNameInput = document.getElementById("fullNameInput");

            function toggleFullNameInput() {
                // Kiểm tra nếu chọn RoleId = 3 (Nhân viên)
                if (roleSelect && roleSelect.value === "3") {
                    divFullName.classList.remove("d-none");
                    fullNameInput.setAttribute("required", "required");
                } else {
                    divFullName.classList.add("d-none");
                    fullNameInput.removeAttribute("required");
                }
            }

            if (roleSelect) {
                roleSelect.addEventListener("change", toggleFullNameInput);
                toggleFullNameInput(); // Khởi chạy kiểm tra khi vừa load trang
            }
        });
    </script>
}