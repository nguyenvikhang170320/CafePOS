<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Admin Cafe</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/bootstrap-icons.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
            body {
                display: flex;
                min-height: 100vh;
                overflow-x: hidden;
                background-color: #f4f6f9;
                font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            }

            /* Sidebar Sidebar Styles */
            #sidebar {
                width: 260px;
                background: #1e2229;
                color: #adb5bd;
                transition: all 0.3s;
                position: fixed;
                height: 100vh;
                z-index: 1000;
                display: flex;
                flex-direction: column;
                box-shadow: 2px 0 10px rgba(0,0,0,0.1);
            }

                #sidebar .sidebar-header {
                    padding: 24px 20px;
                    background: #181b20;
                    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
                }

                #sidebar ul.components {
                    padding: 15px 12px;
                    overflow-y: auto;
                    flex-grow: 1;
                }

                #sidebar ul li {
                    margin-bottom: 4px;
                }

                    #sidebar ul li a {
                        padding: 10px 16px;
                        display: flex;
                        align-items: center;
                        gap: 12px;
                        color: #a0aec0;
                        text-decoration: none;
                        border-radius: 8px;
                        font-size: 0.95rem;
                        font-weight: 500;
                        transition: all 0.2s ease-in-out;
                    }

                        #sidebar ul li a i {
                            font-size: 1.15rem;
                            width: 20px;
                            text-align: center;
                        }

                        #sidebar ul li a:hover {
                            color: #ffffff;
                            background: rgba(255, 255, 255, 0.08);
                        }

                    #sidebar ul li.active > a {
                        color: #ffffff;
                        background: #0d6efd; /* Màu xanh chủ đạo hiện đại */
                        box-shadow: 0 4px 12px rgba(13, 110, 253, 0.35);
                    }

            /* Sub-menu header label */
            .sidebar-heading {
                font-size: 0.75rem;
                text-transform: uppercase;
                letter-spacing: 0.8px;
                color: #6c757d;
                padding: 12px 16px 4px 16px;
                font-weight: 700;
            }

            /* Main Content */
            #content {
                flex: 1;
                margin-left: 260px;
                transition: all 0.3s;
                padding: 24px;
                min-width: 0;
            }

            .top-navbar {
                background: #ffffff;
                padding: 12px 24px;
                border-radius: 12px;
                box-shadow: 0 2px 12px rgba(0,0,0,0.04);
                margin-bottom: 24px;
                display: flex;
                justify-content: space-between;
                align-items: center;
            }

            .user-profile {
                display: flex;
                align-items: center;
                gap: 12px;
            }

            .avatar-circle {
                width: 36px;
                height: 36px;
                background-color: #e9ecef;
                color: #495057;
                border-radius: 50%;
                display: flex;
                align-items: center;
                justify-content: center;
                font-weight: 600;
                font-size: 0.9rem;
            }
    </style>
</head>
<body>
    <!-- Sidebar -->
    <nav id="sidebar">
        <div class="sidebar-header text-center">
            <h5 class="mb-0 fw-bold text-white tracking-wide">
                <i class="bi bi-cup-hot-fill text-warning me-2"></i>CAFE ADMIN
            </h5>
        </div>
        <ul class="list-unstyled components">
            @{
                var currentController = ViewContext.RouteData.Values["Controller"]?.ToString();
            }

            <li class="@(currentController == "Home" ? "active" : "")">
                <a asp-area="Admin" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-grid-1x2-fill"></i> <span>Dashboard</span>
                </a>
            </li>

            <div class="sidebar-heading">Quản lý hệ thống</div>

            <li class="@(currentController == "TaiKhoan" ? "active" : "")">
                <a asp-area="Admin" asp-controller="TaiKhoan" asp-action="Index">
                    <i class="bi bi-person-gear"></i> <span>Quản lý Tài Khoản</span>
                </a>
            </li>

            <li class="@(currentController == "Employee" ? "active" : "")">
                <a asp-area="Admin" asp-controller="Employee" asp-action="Index">
                    <i class="bi bi-people-fill"></i> <span>Quản lý Nhân viên</span>
                </a>
            </li>

            <li class="@(currentController == "Position" ? "active" : "")">
                <a asp-area="Admin" asp-controller="Position" asp-action="Index">
                    <i class="bi bi-person-badge-fill"></i> <span>Chức danh Nhân viên</span>
                </a>
            </li>

            <div class="sidebar-heading">Menu & Thực đơn</div>

            <li class="@(currentController == "Category" ? "active" : "")">
                <a asp-area="Admin" asp-controller="Category" asp-action="Index">
                    <i class="bi bi-folder-fill"></i> <span>Quản lý Danh mục</span>
                </a>
            </li>

            <li class="@(currentController == "Product" ? "active" : "")">
                <a asp-area="Admin" asp-controller="Product" asp-action="Index">
                    <i class="bi bi-cup-hot-fill"></i> <span>Quản lý Sản phẩm</span>
                </a>
            </li>

            <li class="@(currentController == "ProductSize" ? "active" : "")">
                <a asp-area="Admin" asp-controller="ProductSize" asp-action="Index">
                    <i class="bi bi-aspect-ratio-fill"></i> <span>Sản phẩm chọn Size</span>
                </a>
            </li>

            <li class="@(currentController == "Topping" ? "active" : "")">
                <a asp-area="Admin" asp-controller="Topping" asp-action="Index">
                    <i class="bi bi-layers-fill"></i> <span>Quản lý Topping</span>
                </a>
            </li>

            <li class="@(currentController == "Table" ? "active" : "")">
                <a asp-area="Admin" asp-controller="Table" asp-action="Index">
                    <i class="bi bi-geo-alt-fill"></i> <span>Quản lý Khu & Bàn</span>
                </a>
            </li>

            <div class="sidebar-heading">Kinh doanh</div>

            <li class="@(currentController == "Order" ? "active" : "")">
                <a asp-area="Admin" asp-controller="Order" asp-action="Index">
                    <i class="bi bi-receipt-cutoff"></i> <span>Quản lý Đơn hàng</span>
                </a>
            </li>

            <li class="@(currentController == "Revenue" ? "active" : "")">
                <a asp-area="Admin" asp-controller="Revenue" asp-action="Index">
                    <i class="bi bi-graph-up-arrow"></i> <span>Báo cáo Doanh thu</span>
                </a>
            </li>
        </ul>
    </nav>

    <!-- Main Content Area -->
    <div id="content">
        <!-- Top Navbar -->
        <div class="top-navbar">
            <div class="d-flex align-items-center">
                <h5 class="mb-0 fw-bold text-dark">@ViewData["Title"]</h5>
            </div>

            <div class="user-profile">
                <div class="avatar-circle">
                    @(User.Identity?.Name?.Substring(0, 1).ToUpper() ?? "A")
                </div>
                <span class="fw-semibold text-secondary me-2">Chào, @User.Identity?.Name</span>
                <a asp-area="" asp-controller="Account" asp-action="Logout" class="btn btn-sm btn-outline-danger rounded-pill px-3">
                    <i class="bi bi-box-arrow-right me-1"></i> Đăng xuất
                </a>
            </div>
        </div>

        <!-- Body Content -->
        <div class="container-fluid p-0">
            @RenderBody()
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>