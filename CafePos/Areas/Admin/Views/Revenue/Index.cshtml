@model CafePos.Models.ViewModels.ReportDashboardViewModel

@{
    ViewData["Title"] = "Báo cáo doanh thu";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="container py-4">
    <!-- Header & Year Selector -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Báo cáo doanh thu</h2>
            <p class="text-muted mb-0">Thống kê doanh thu theo tháng, năm và món bán chạy.</p>
        </div>

        <form method="get" asp-action="Index" class="d-flex gap-2">
            <input type="number" name="year" value="@Model.SelectedYear" class="form-control" style="width: 140px;" />
            <button type="submit" class="btn btn-primary">Xem</button>
        </form>
    </div>

    <!-- Cards Summary -->
    <div class="row g-3 mb-4">
        <div class="col-md-6">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body">
                    <h6 class="text-muted">Tổng doanh thu năm @Model.SelectedYear</h6>
                    <h3 class="fw-bold text-success">@Model.TotalRevenueThisYear.ToString("N0") đ</h3>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body">
                    <h6 class="text-muted">Tổng số đơn năm @Model.SelectedYear</h6>
                    <h3 class="fw-bold text-primary">@Model.TotalOrdersThisYear</h3>
                </div>
            </div>
        </div>
    </div>

    <!-- Biểu đồ doanh thu 7 ngày gần nhất -->
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body p-4">
            <h5 class="fw-bold mb-3">
                <i class="bi bi-graph-up-arrow text-primary me-2"></i>Biểu đồ doanh thu 7 ngày gần nhất
            </h5>
            <div style="height: 300px; position: relative;">
                <canvas id="revenueChart"></canvas>
            </div>
        </div>
    </div>

    <!-- Doanh thu theo tháng -->
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body">
            <h5 class="fw-bold mb-3">Doanh thu theo tháng</h5>
            <div class="table-responsive">
                <table class="table table-bordered align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Tháng</th>
                            <th>Số đơn</th>
                            <th>Doanh thu</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.MonthlyRevenues != null && Model.MonthlyRevenues.Any())
                        {
                            foreach (var item in Model.MonthlyRevenues)
                            {
                                <tr>
                                    <td>Tháng @item.Month/@item.Year</td>
                                    <td>@item.TotalOrders</td>
                                    <td class="fw-bold text-danger">@item.TotalRevenue.ToString("N0") đ</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="3" class="text-center text-muted">Chưa có dữ liệu doanh thu theo tháng.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Doanh thu theo năm -->
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body">
            <h5 class="fw-bold mb-3">Doanh thu theo năm</h5>
            <div class="table-responsive">
                <table class="table table-bordered align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Năm</th>
                            <th>Số đơn</th>
                            <th>Doanh thu</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.YearlyRevenues != null && Model.YearlyRevenues.Any())
                        {
                            foreach (var item in Model.YearlyRevenues)
                            {
                                <tr>
                                    <td>@item.Year</td>
                                    <td>@item.TotalOrders</td>
                                    <td class="fw-bold text-success">@item.TotalRevenue.ToString("N0") đ</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="3" class="text-center text-muted">Chưa có dữ liệu doanh thu theo năm.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Top món bán chạy -->
    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body">
            <h5 class="fw-bold mb-3">Top món bán chạy</h5>
            <div class="table-responsive">
                <table class="table table-bordered align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Tên món</th>
                            <th>Số lượng bán</th>
                            <th>Doanh thu</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.BestSellingProducts != null && Model.BestSellingProducts.Any())
                        {
                            foreach (var item in Model.BestSellingProducts)
                            {
                                <tr>
                                    <td>@item.ProductName</td>
                                    <td>@item.TotalQuantitySold</td>
                                    <td class="fw-bold text-primary">@item.TotalRevenue.ToString("N0") đ</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="3" class="text-center text-muted">Chưa có dữ liệu món bán chạy.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <!-- Thư viện Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function() {
            // Lấy dữ liệu 7 ngày từ ViewModel (Giả định ViewModel có danh sách Last7DaysRevenues)
            const rawData = @Html.Raw(Json.Serialize(Model.Last7DaysRevenues ?? new List<CafePos.Models.ViewModels.DailyRevenueViewModel>()));

            const labels = rawData.map(item => item.DateFormatted || item.Date);
            const dataValues = rawData.map(item => item.TotalRevenue);

            const ctx = document.getElementById('revenueChart').getContext('2d');
            new Chart(ctx, {
                type: 'line',
                data: {
                    labels: labels,
                    datasets: [{
                        label: 'Doanh thu (VNĐ)',
                        data: dataValues,
                        borderColor: '#0d6efd',
                        backgroundColor: 'rgba(13, 110, 253, 0.1)',
                        borderWidth: 2,
                        fill: true,
                        tension: 0.3,
                        pointRadius: 4,
                        pointBackgroundColor: '#0d6efd'
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            callbacks: {
                                label: function(context) {
                                    let value = context.raw || 0;
                                    return 'Doanh thu: ' + value.toLocaleString('vi-VN') + ' đ';
                                }
                            }
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            ticks: {
                                callback: function(value) {
                                    return value.toLocaleString('vi-VN') + ' đ';
                                }
                            }
                        }
                    }
                }
            });
        });
    </script>
}