@model Order

<style>
    /* Custom Soft Badges & Elements */
    .badge-soft-success {
        background-color: #d1e7dd;
        color: #0f5132;
    }

    .badge-soft-warning {
        background-color: #fff3cd;
        color: #664d03;
    }

    .badge-soft-danger {
        background-color: #f8d7da;
        color: #842029;
    }

    .badge-soft-secondary {
        background-color: #e2e3e5;
        color: #41464b;
    }

    .topping-chip {
        font-size: 0.75rem;
        background-color: #f8f9fa;
        border: 1px solid #e9ecef;
        border-radius: 6px;
        padding: 2px 8px;
        display: inline-block;
    }
</style>

<div class="card border-0 shadow-sm rounded-4 overflow-hidden">
    <!-- Header -->
    <div class="card-header bg-white py-3 px-4 border-bottom d-flex justify-content-between align-items-center flex-wrap gap-2">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <h5 class="mb-0 fw-bold text-dark">Hóa đơn #@Model.OrderCode</h5>
                @if (Model.PaymentStatus == "Paid")
                {
                    <span class="badge badge-soft-success rounded-pill px-3"><i class="bi bi-check-circle-fill me-1"></i>Đã thanh toán</span>
                }
                else
                {
                    <span class="badge badge-soft-danger rounded-pill px-3"><i class="bi bi-clock-fill me-1"></i>Chưa thanh toán</span>
                }
            </div>
            <div class="text-muted small">
                <i class="bi bi-calendar3 me-1"></i>Ngày tạo: @Model.CreatedDate.ToString("dd/MM/yyyy HH:mm")
            </div>
        </div>

        <!-- Action Links -->
        <div class="d-flex gap-2">
            <a asp-area="Admin"
               asp-controller="Order"
               asp-action="PrintInvoice"
               asp-route-id="@Model.OrderId"
               target="_blank"
               class="btn btn-outline-secondary btn-sm rounded-pill px-3 shadow-sm">
                <i class="bi bi-printer me-1"></i> In hóa đơn
            </a>

            <a asp-area="Admin"
               asp-controller="Order"
               asp-action="Checkout"
               asp-route-id="@Model.OrderId"
               class="btn btn-outline-primary btn-sm rounded-pill px-3 shadow-sm">
                <i class="bi bi-pencil-square me-1"></i> Sửa / POS
            </a>
        </div>
    </div>

    <div class="card-body p-4">
        <!-- Client & Order Status Info -->
        <div class="row g-3 mb-4">
            <div class="col-md-6">
                <div class="p-3 bg-light rounded-4 h-100 border border-light">
                    <div class="d-flex align-items-center mb-2">
                        <i class="bi bi-person-circle fs-5 text-primary me-2"></i>
                        <span class="fw-bold text-dark">Thông tin khách hàng</span>
                    </div>
                    <div class="small text-muted">Họ tên</div>
                    <div class="fw-semibold text-dark mb-2">@(string.IsNullOrEmpty(Model.CustomerName) ? "Khách vãng lai" : Model.CustomerName)</div>

                    <div class="small text-muted">Số điện thoại</div>
                    <div class="fw-semibold text-dark">@(string.IsNullOrEmpty(Model.CustomerPhone) ? "Chưa cung cấp" : Model.CustomerPhone)</div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="p-3 bg-light rounded-4 h-100 border border-light">
                    <div class="d-flex align-items-center mb-2">
                        <i class="bi bi-info-circle fs-5 text-primary me-2"></i>
                        <span class="fw-bold text-dark">Trạng thái đơn hàng</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="small text-muted">Trạng thái xử lý:</span>
                        <div>
                            @if (Model.OrderStatus == "Completed")
                            {
                                <span class="badge badge-soft-success rounded-pill">Hoàn thành</span>
                            }
                            else if (Model.OrderStatus == "Pending")
                            {
                                <span class="badge badge-soft-warning rounded-pill">Chờ xử lý</span>
                            }
                            else
                            {
                                <span class="badge badge-soft-secondary rounded-pill">@(Model.OrderStatus == "Cancelled" ? "Đã hủy" : Model.OrderStatus)</span>
                            }
                        </div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center">
                        <span class="small text-muted">Phương thức thanh toán:</span>
                        <span class="fw-semibold text-dark small">@(string.IsNullOrEmpty(Model.PaymentMethod) ? "Chưa chọn" : Model.PaymentMethod)</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Quick Payment Buttons (Kích hoạt Script AJAX) -->
        @if (Model.PaymentStatus != "Paid")
        {
            <div class="alert alert-warning border-0 rounded-4 p-3 mb-4 d-flex justify-content-between align-items-center flex-wrap gap-2">
                <div class="d-flex align-items-center">
                    <i class="bi bi-exclamation-triangle-fill fs-4 text-warning me-3"></i>
                    <div>
                        <div class="fw-bold text-dark">Đơn hàng chưa thanh toán</div>
                        <div class="small text-muted">Bấm chọn phương thức bên phải để xác nhận thanh toán nhanh.</div>
                    </div>
                </div>
                <div class="d-flex gap-2">
                    <button type="button"
                            class="btn btn-success btn-sm rounded-pill px-3 btn-mark-paid"
                            data-id="@Model.OrderId"
                            data-method="Cash">
                        <i class="bi bi-cash me-1"></i> Tiền mặt
                    </button>
                    <button type="button"
                            class="btn btn-primary btn-sm rounded-pill px-3 btn-mark-paid"
                            data-id="@Model.OrderId"
                            data-method="Banking">
                        <i class="bi bi-qr-code me-1"></i> Chuyển khoản
                    </button>
                    <button type="button"
                            class="btn btn-primary btn-sm rounded-pill px-3 btn-mark-paid"
                            data-id="@Model.OrderId"
                            data-method="">
                        <i class="bi bi-qr-code me-1"></i> Chuyển khoản
                    </button>
                </div>
            </div>
        }

        <!-- Product Table -->
        <div class="table-responsive rounded-3 border">
            <table class="table align-middle mb-0">
                <thead class="bg-light text-muted small text-uppercase">
                    <tr>
                        <th class="ps-3">Món</th>
                        <th class="text-center">SL</th>
                        <th class="text-end">Đơn giá</th>
                        <th>Topping</th>
                        <th class="text-end pe-3">Thành tiền</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.OrderItems != null && Model.OrderItems.Any())
                    {
                        foreach (var item in Model.OrderItems)
                        {
                            <tr>
                                <td class="ps-3">
                                    <div class="fw-bold text-dark">@item.ProductNameSnapshot</div>

                                    @if (!string.IsNullOrEmpty(item.SizeNameSnapshot))
                                    {
                                        <div class="small text-muted">
                                            Size: <span class="badge bg-light text-dark border">@item.SizeNameSnapshot</span>
                                        </div>
                                    }

                                    @if (!string.IsNullOrEmpty(item.ItemNote))
                                    {
                                        <div class="small text-warning mt-1">
                                            <i class="bi bi-chat-left-dots me-1"></i>Ghi chú: @item.ItemNote
                                        </div>
                                    }
                                </td>
                                <td class="text-center fw-bold text-dark">@item.Quantity</td>
                                <td class="text-end text-muted">@item.UnitPrice.ToString("N0") đ</td>
                                <td>
                                    @if (item.OrderItemToppings != null && item.OrderItemToppings.Any())
                                    {
                                        <div class="d-flex flex-wrap gap-1">
                                            @foreach (var top in item.OrderItemToppings)
                                            {
                                                <span class="topping-chip text-muted">
                                                    + @top.ToppingNameSnapshot (x@top.Quantity)
                                                    <span class="text-primary fw-semibold">+@top.TotalPrice.ToString("N0")đ</span>
                                                </span>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">Không</span>
                                    }
                                </td>
                                <td class="text-end pe-3 fw-bold text-dark">@item.LineTotal.ToString("N0") đ</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center text-muted py-4">Không có món nào trong đơn.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Note & Total Summary -->
        <div class="row mt-4 g-3">
            <div class="col-md-6">
                @if (!string.IsNullOrEmpty(Model.Note))
                {
                    <div class="p-3 bg-light rounded-4 border border-light">
                        <div class="fw-bold text-dark mb-1"><i class="bi bi-sticky me-1 text-primary"></i>Ghi chú đơn hàng</div>
                        <div class="text-muted small">@Model.Note</div>
                    </div>
                }
            </div>

            <div class="col-md-6">
                <div class="p-3 bg-light rounded-4 border border-light">
                    <div class="d-flex justify-content-between mb-2 text-muted">
                        <span>Tạm tính</span>
                        <span>@Model.SubTotal.ToString("N0") đ</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2 text-muted">
                        <span>Giảm giá</span>
                        <span class="text-danger">-@Model.DiscountAmount.ToString("N0") đ</span>
                    </div>
                    <hr class="my-2" />
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="fw-bold text-dark">Tổng tiền</span>
                        <span class="fw-bold text-primary fs-4">@Model.TotalAmount.ToString("N0") đ</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- AJAX Script Xử Lý Thanh Toán Nhanh -->
<script>
    $(document).ready(function() {
        $(".btn-mark-paid").off("click").on("click", function() {
            let id = $(this).data("id");
            let method = $(this).data("method");

            if (confirm(`Xác nhận thanh toán đơn hàng này bằng [${method}]?`)) {
                $.ajax({
                    url: '@Url.Action("MarkAsPaid", "Order", new { area = "Admin" })',
                    type: 'POST',
                    data: { id: id, paymentMethod: method },
                    success: function(res) {
                        if (res.success) {
                            $.get('@Url.Action("GetInvoicePartial", "Order", new { area = "Admin" })',
                                { id: id },
                                function(html) {
                                    $("#invoiceDetail").html(html);
                                });
                        } else {
                            alert(res.message || "Không thể cập nhật trạng thái thanh toán.");
                        }
                    },
                    error: function() {
                        alert("Có lỗi xảy ra khi gửi yêu cầu thanh toán.");
                    }
                });
            }
        });
    });
</script>