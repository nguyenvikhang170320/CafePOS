@model Order
@using CafePos.Models

@{
    ViewData["Title"] = "Checkout";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";

    var toppings = ViewBag.Toppings as List<Topping>;
    var tablesList = ViewBag.TablesList as List<Table>;
    var employeesList = ViewBag.EmployeesList as List<Employee>;

    var bankId = ViewBag.BankId?.ToString() ?? "";
    var accountNumber = ViewBag.BankAccountNumber?.ToString() ?? "";
    var accountName = ViewBag.BankAccountName?.ToString() ?? "";

    var qrDescription = $"CafePOS {Model.OrderCode}";

    var vietQrUrl =
        $"https://img.vietqr.io/image/{bankId}-{accountNumber}-compact2.png" +
        $"?amount={Model.TotalAmount:0}" +
        $"&addInfo={Uri.EscapeDataString(qrDescription)}" +
        $"&accountName={Uri.EscapeDataString(accountName)}";
}

<div class="container-fluid py-4">

    <div class="mb-4">
        <h3 class="fw-bold mb-1">
            Checkout đơn hàng
        </h3>

        <p class="text-muted mb-0">
            Xác nhận thanh toán, chọn nhân viên thu ngân,
            chọn bàn ăn và hoàn tất đơn.
        </p>
    </div>

    <div class="row g-4">

        <div class="col-lg-8">

            <div class="card border-0 shadow-sm rounded-4">

                <div class="card-header bg-success text-white rounded-top-4 py-3">
                    <h5 class="mb-0 fw-bold">
                        <i class="bi bi-credit-card-2-back me-2"></i>
                        Chi tiết thanh toán
                    </h5>
                </div>

                <div class="card-body">

                    <!-- THÔNG TIN ĐƠN -->
                    <div class="row g-3 mb-4">

                        <div class="col-md-6">
                            <div class="p-3 bg-light rounded-4">
                                <div class="small text-muted">
                                    Mã đơn
                                </div>

                                <div class="fw-semibold">
                                    @Model.OrderCode
                                </div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="p-3 bg-light rounded-4">

                                <div class="small text-muted">
                                    Ngày tạo
                                </div>

                                <div class="fw-semibold">
                                    @Model.CreatedDate.ToString("dd/MM/yyyy HH:mm")
                                </div>

                            </div>
                        </div>

                    </div>


                    <form id="checkoutForm"
                          asp-controller="Order"
                          asp-action="Checkout"
                          method="post">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               name="id"
                               value="@Model.OrderId" />


                        <div class="row g-3 align-items-end mb-4">


                            <!-- NHÂN VIÊN THỰC HIỆN -->

                            <div class="col-md-6 mb-3">

                                <label class="form-label font-weight-bold">
                                    Nhân viên thực hiện
                                    <span class="text-danger">*</span>
                                </label>


                                @if (
                                    Model.PaymentStatus == "Paid" ||
                                    Model.PaymentStatus == "Đã thanh toán" ||
                                    Model.OrderStatus == "Completed"
                                )
                                {

                                    <select name="employeeId"
                                            class="form-select"
                                            disabled>

                                        <option value="">
                                            -- Chưa ghi nhận --
                                        </option>


                                        @if (ViewBag.EmployeesList != null)
                                        {
                                            foreach (
                                                var emp in
                                                (List<CafePos.Models.Employee>)
                                                ViewBag.EmployeesList
                                            )
                                            {

                                                <option value="@emp.EmployeeId"
                                                        selected="@(emp.EmployeeId == ViewBag.SelectedEmployeeId)">

                                                    @emp.FullName
                                                    (@emp.Position?.PositionName)

                                                </option>
                                            }
                                        }

                                    </select>

                                }
                                else
                                {

                                    <select name="employeeId"
                                            class="form-select"
                                            required>

                                        <option value="">
                                            -- Chọn nhân viên đứng ca --
                                        </option>


                                        @if (ViewBag.EmployeesList != null)
                                        {
                                            foreach (
                                                var emp in
                                                (List<CafePos.Models.Employee>)
                                                ViewBag.EmployeesList
                                            )
                                            {

                                                <option value="@emp.EmployeeId"
                                                        selected="@(emp.EmployeeId == ViewBag.SelectedEmployeeId)">

                                                    @emp.FullName
                                                    (@emp.Position?.PositionName)

                                                </option>
                                            }
                                        }

                                    </select>

                                }

                            </div>



                            <!-- BÀN -->

                            <div class="col-md-6">

                                <label class="form-label fw-bold">

                                    <i class="bi bi-table text-primary me-1"></i>

                                    Bàn ăn / Khu vực

                                </label>


                                <select name="tableId"
                                        class="form-select rounded-3">

                                    <option value="">
                                        -- Mua mang về (Không bàn) --
                                    </option>


                                    @if (tablesList != null)
                                    {

                                        var groupedTables =
                                            tablesList.GroupBy(
                                                t =>
                                                    string.IsNullOrEmpty(t.Area)
                                                        ? "Khác / Chưa phân khu"
                                                        : t.Area
                                            );


                                        foreach (var group in groupedTables)
                                        {

                                            <optgroup label="📍 @group.Key">

                                                @foreach (var table in group)
                                                {

                                                    <option value="@table.TableId"
                                                            selected="@(Model.TableId == table.TableId ? "selected" : null)">

                                                        @table.TableName

                                                    </option>

                                                }

                                            </optgroup>

                                        }

                                    }

                                </select>

                            </div>



                            <!-- PHƯƠNG THỨC THANH TOÁN -->

                            <div class="col-md-6">

                                <label class="form-label fw-bold">

                                    <i class="bi bi-wallet2 text-success me-1"></i>

                                    Phương thức thanh toán

                                </label>


                                <select id="paymentMethodSelect"
                                        name="paymentMethod"
                                        class="form-select"
                                    @(Model.PaymentStatus == "Paid" ? "disabled" : "")>

                                    <option value="Cash"
                                            selected="@(Model.PaymentMethod == "Cash" || Model.PaymentMethod == "Tiền mặt")">

                                        Tiền mặt

                                    </option>


                                    <option value="Banking"
                                            selected="@(Model.PaymentMethod == "Banking" || Model.PaymentMethod == "Chuyển khoản")">

                                        Chuyển khoản / QR

                                    </option>


                                    <option value="Card"
                                            selected="@(Model.PaymentMethod == "Card" || Model.PaymentMethod == "Thẻ")">

                                        Thẻ

                                    </option>


                                    <option value="VNPAY"
                                            selected="@(Model.PaymentMethod == "VNPAY" || Model.PaymentMethod == "VNPay")">

                                        VNPAY

                                    </option>

                                </select>

                            </div>



                            <!-- GIẢM GIÁ -->

                            <div class="col-md-6">

                                <label class="form-label fw-bold">

                                    <i class="bi bi-cash text-danger me-1"></i>

                                    Giảm giá (đ)

                                </label>


                                <input type="number"
                                       step="1000"
                                       min="0"
                                       name="discountAmount"
                                       id="discountAmount"
                                       class="form-control rounded-3 fw-bold text-danger"
                                       value="@Model.DiscountAmount.ToString("F0")" />

                            </div>

                        </div>



                        <!-- ================================ -->
                        <!-- BANKING / VIETQR -->
                        <!-- ================================ -->

                        <div id="bankingQrBox"
                             class="card border-0 bg-light rounded-4 p-4 mt-3"
                             style="display:none;">


                            <div class="text-center">

                                <h5 class="fw-bold mb-3">

                                    <i class="bi bi-qr-code-scan me-2"></i>

                                    Quét QR chuyển khoản

                                </h5>


                                @if (
                                    !string.IsNullOrWhiteSpace(bankId) &&
                                    !string.IsNullOrWhiteSpace(accountNumber)
                                )
                                {

                                    <img src="@vietQrUrl"
                                         alt="VietQR"
                                         class="img-fluid rounded-3"
                                         style="max-width:300px;" />


                                    <div class="mt-3">

                                        <div class="fw-bold">
                                            @accountName
                                        </div>


                                        <div class="text-muted">
                                            STK: @accountNumber
                                        </div>


                                        <div class="fs-4 fw-bold text-danger mt-2">

                                            @Model.TotalAmount.ToString("N0") đ

                                        </div>


                                        <div class="small text-muted mt-2">

                                            Nội dung:

                                            <strong>
                                                @qrDescription
                                            </strong>

                                        </div>

                                    </div>


                                    <div class="alert alert-warning mt-3 mb-0">

                                        <i class="bi bi-exclamation-triangle me-1"></i>

                                        Vui lòng kiểm tra tiền đã vào tài khoản
                                        trước khi xác nhận thanh toán.

                                    </div>

                                }
                                else
                                {

                                    <div class="alert alert-danger mb-0">

                                        Chưa cấu hình thông tin ngân hàng
                                        để tạo VietQR.

                                    </div>

                                }

                            </div>

                        </div>



                        <!-- ================================ -->
                        <!-- NÚT THANH TOÁN -->
                        <!-- ================================ -->

                        <div class="mt-4 d-flex gap-2">


                            @if (
                                Model.PaymentStatus == "Paid" ||
                                Model.OrderStatus == "Completed"
                            )
                            {

                                <button type="button"
                                        class="btn btn-secondary rounded-pill px-4"
                                        disabled>

                                    <i class="bi bi-check-all me-1"></i>

                                    Đơn đã thanh toán

                                </button>

                            }
                            else
                            {

                                <!-- CASH / BANKING / CARD -->

                                <button type="submit"
                                        id="btnNormalPay"
                                        class="btn btn-success rounded-pill px-4 fw-bold">

                                    <i class="bi bi-cash-register me-1"></i>

                                    Xác nhận thanh toán

                                </button>


                                <!-- VNPAY -->

                                <button type="submit"
                                        id="btnVnPay"
                                        class="btn btn-primary rounded-pill px-4 fw-bold d-none"
                                        style="
                                    background-color:#005baa;
                                    border:none;
                                    ">

                                    <i class="bi bi-qr-code-scan me-1"></i>

                                    Thanh toán qua VNPAY

                                </button>

                            }

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>


@section Scripts {

    <script>

        document.addEventListener(
            'DOMContentLoaded',
            function() {

                const selectMethod =
                    document.getElementById(
                        'paymentMethodSelect'
                    );


                const btnNormalPay =
                    document.getElementById(
                        'btnNormalPay'
                    );


                const btnVnPay =
                    document.getElementById(
                        'btnVnPay'
                    );


                const bankingQrBox =
                    document.getElementById(
                        'bankingQrBox'
                    );



                function updatePaymentUI() {

                    if (!selectMethod) {
                        return;
                    }


                    const method =
                        selectMethod.value;



                    // ================================
                    // VNPAY
                    // ================================

                    if (method === 'VNPAY') {

                        btnNormalPay?.classList.add(
                            'd-none'
                        );

                        btnVnPay?.classList.remove(
                            'd-none'
                        );

                    }
                    else {

                        btnNormalPay?.classList.remove(
                            'd-none'
                        );

                        btnVnPay?.classList.add(
                            'd-none'
                        );

                    }



                    // ================================
                    // BANKING / VIETQR
                    // ================================

                    if (bankingQrBox) {

                        bankingQrBox.style.display =
                            method === 'Banking'
                                ? 'block'
                                : 'none';

                    }

                }



                selectMethod?.addEventListener(
                    'change',
                    updatePaymentUI
                );


                updatePaymentUI();

            }
        );

    </script>

}