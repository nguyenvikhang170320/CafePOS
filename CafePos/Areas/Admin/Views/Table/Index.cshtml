@model IEnumerable<CafePos.Models.Table>
@{
    ViewData["Title"] = "Danh sách bàn ăn";
    bool isAdmin = User.IsInRole("Admin");
    int i = 1;
}

<style>
    .custom-card {
        border-radius: 15px;
        overflow: hidden;
        border: none;
        box-shadow: 0 5px 15px rgba(0,0,0,0.05) !important;
    }

    .btn-action {
        width: 35px;
        height: 35px;
        padding: 0;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 10px;
        margin-left: 5px;
    }

    .badge-stt {
        background: #f1f3f5;
        color: #495057;
        font-weight: 700;
        width: 30px;
        height: 30px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 8px;
        font-size: 0.85rem;
        border: 1px solid #dee2e6;
    }

    .badge-area {
        background: #e0f2fe;
        color: #0369a1;
        font-weight: 600;
        padding: 0.4em 0.8em;
        border-radius: 8px;
        font-size: 0.85rem;
    }

    .badge-active {
        background: #e8f5e9;
        color: #2e7d32;
        font-weight: 600;
        padding: 0.5em 1em;
        border-radius: 8px;
        display: inline-block;
    }

    .badge-inactive {
        background: #ffebee;
        color: #c62828;
        font-weight: 600;
        padding: 0.5em 1em;
        border-radius: 8px;
        display: inline-block;
    }
</style>

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="text-dark fw-bold mb-0"><i class="bi bi-table text-warning me-2"></i>Danh sách bàn ăn</h3>
            <p class="text-muted small mb-0">Quản lý sơ đồ bàn theo từng khu vực</p>
        </div>
        @if (isAdmin)
        {
            <a asp-action="Create" class="btn btn-primary px-3 shadow-sm fw-bold">
                <i class="bi bi-plus-lg me-1"></i> Thêm mới
            </a>
        }
    </div>

    <div class="card custom-card">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0 align-middle">
                    <thead class="bg-light">
                        <tr>
                            <th class="text-center py-3" style="width: 80px;">STT</th>
                            <th style="width: 180px;">Khu vực</th>
                            <th>Tên bàn</th>
                            <th class="text-center" style="width: 200px;">Trạng thái</th>
                            @if (isAdmin)
                            {
                                <th class="text-end pe-4" style="width: 180px;">Thao tác</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="text-center"><span class="badge-stt">@i.ToString("D2")</span></td>
                                    <td>
                                        <span class="badge-area">
                                            <i class="bi bi-geo-alt me-1"></i>@(string.IsNullOrEmpty(item.Area) ? "Chưa phân khu" : item.Area)
                                        </span>
                                    </td>
                                    <td><span class="fw-bold text-dark fs-6">@item.TableName</span></td>
                                    <td class="text-center">
                                        @if (item.IsActive)
                                        {
                                            <span class="badge-active"><i class="bi bi-check-circle me-1"></i>Đang hoạt động</span>
                                        }
                                        else
                                        {
                                            <span class="badge-inactive"><i class="bi bi-dash-circle me-1"></i>Tạm khóa</span>
                                        }
                                    </td>
                                    @if (isAdmin)
                                    {
                                        <td class="text-end pe-4">
                                            <div class="d-flex justify-content-end align-items-center">
                                                <a asp-action="Edit" asp-route-id="@item.TableId" class="btn btn-action btn-outline-warning" title="Chỉnh sửa">
                                                    <i class="bi bi-pencil-square"></i>
                                                </a>
                                                <form asp-action="ToggleStatus" asp-route-id="@item.TableId" method="post" onsubmit="return confirm('Đổi trạng thái bàn?');" class="d-inline ms-1">
                                                    @if (item.IsActive)
                                                    {
                                                        <button type="submit" class="btn btn-action btn-outline-danger" title="Khóa bàn"><i class="bi bi-lock"></i></button>
                                                    }
                                                    else
                                                    {
                                                        <button type="submit" class="btn btn-action btn-outline-success" title="Mở khóa"><i class="bi bi-unlock"></i></button>
                                                    }
                                                </form>
                                            </div>
                                        </td>
                                    }
                                </tr>
                                i++;
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>