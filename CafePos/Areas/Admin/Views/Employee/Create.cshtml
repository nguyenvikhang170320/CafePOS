@model CafePos.Models.ViewModels.EmployeeVM

@{
    ViewData["Title"] = "Thêm mới Nhân viên";
}

<div class="card shadow border-0 mt-4">
    <div class="card-header bg-primary bg-gradient ml-0 py-3">
        <h4 class="text-white mb-0">Thêm mới Nhân viên</h4>
    </div>
    <div class="card-body p-4">
        <!-- Thêm autocomplete="off" vào form -->
        <form asp-action="Create" method="post" enctype="multipart/form-data" autocomplete="off">

            <!-- Mẹo "bẫy" Chrome Autofill: Để 2 input ẩn này lên đầu form -->
            <input type="text" name="fake_usernameremembered" style="display:none;" />
            <input type="password" name="fake_passwordremembered" style="display:none;" />

            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <h5 class="text-secondary mb-3"><i class="bi bi-person-badge"></i> Thông tin Tài khoản</h5>
            <div class="row">
                <div class="col-md-4 mb-3">
                    <label class="form-label font-weight-bold">Tên đăng nhập <span class="text-danger">*</span></label>
                    <!-- Bổ sung autocomplete="off" -->
                    <input asp-for="Username" class="form-control" placeholder="Nhập tên đăng nhập" autocomplete="off" />
                    <span asp-validation-for="Username" class="text-danger"></span>
                </div>
                <div class="col-md-4 mb-3">
                    <label class="form-label font-weight-bold">Mật khẩu <span class="text-danger">*</span></label>
                    <!-- Chuyển autocomplete="new-password" để Chrome không tự điền pass cũ -->
                    <input asp-for="Password" type="password" class="form-control" placeholder="Nhập mật khẩu" autocomplete="new-password" />
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>
                <div class="col-md-4 mb-3">
                    <label class="form-label font-weight-bold">Email</label>
                    <input asp-for="Email" type="email" class="form-control" placeholder="nhanvien@gmail.com" autocomplete="off" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>
            </div>

            <hr class="my-4" />

            <h5 class="text-secondary mb-3"><i class="bi bi-card-heading"></i> Thông tin Hồ sơ Nhân viên</h5>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label font-weight-bold">Họ và Tên <span class="text-danger">*</span></label>
                    <input asp-for="FullName" class="form-control" placeholder="Nguyễn Văn A" autocomplete="off" />
                    <span asp-validation-for="FullName" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label font-weight-bold">Chức danh / Vị trí <span class="text-danger">*</span></label>
                    <select asp-for="PositionId" asp-items="ViewBag.PositionId" class="form-select">
                        <option value="">-- Chọn Chức danh --</option>
                    </select>
                    <span asp-validation-for="PositionId" class="text-danger"></span>
                </div>
                <div class="col-md-4 mb-3">
                    <label class="form-label">Mã Nhân viên (Để trống sẽ tự sinh)</label>
                    <input asp-for="EmployeeCode" class="form-control" placeholder="VD: NV001" autocomplete="off" />
                </div>
                <div class="col-md-4 mb-3">
                    <label class="form-label">Số điện thoại</label>
                    <input asp-for="PhoneNumber" class="form-control" placeholder="0901234567" autocomplete="off" />
                </div>
                <div class="col-md-4 mb-3">
                    <label class="form-label">Ảnh đại diện</label>
                    <input type="file" name="file" class="form-control" accept="image/*" />
                </div>
                <div class="col-md-12 mb-3">
                    <label class="form-label">Địa chỉ</label>
                    <input asp-for="Address" class="form-control" placeholder="Nhập địa chỉ chỗ ở" autocomplete="off" />
                </div>
            </div>

            <div class="mt-4">
                <button type="submit" class="btn btn-success px-4"><i class="bi bi-check-circle"></i> Lưu Nhân Viên</button>
                <a asp-action="Index" class="btn btn-outline-secondary px-4">Quay lại</a>
            </div>
        </form>
    </div>
</div>