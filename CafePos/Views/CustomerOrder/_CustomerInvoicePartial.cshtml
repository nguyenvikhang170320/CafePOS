@model Order

<div class="card border-0 shadow-sm rounded-4 overflow-hidden">
    <!-- Header Hóa đơn -->
    <div class="card-header bg-dark text-white p-4 d-flex justify-content-between align-items-center">
        <div>
            <h4 class="fw-bold mb-1">HÓA ĐƠN BÁN HÀNG</h4>
            <span class="badge bg-light text-dark">Mã: @Model.OrderCode</span>
        </div>
        <div class="text-end small">
            <div>Ngày tạo: @Model.CreatedDate.ToString("dd/MM/yyyy HH:mm")</div>
            <div>Trạng thái: <strong>@Model.OrderStatus</strong></div>
        </div>
    </div>

    <div class="card-body p-4">
        <!-- Thông tin người mua -->
        <div class="row g-3 mb-4 p-3 bg-light rounded-3">
            <div class="col-md-6">
                <span class="text-muted small d-block">Khách hàng:</span>
                <strong class="text-dark">@Model.CustomerName</strong>
            </div>
            <div class="col-md-6">
                <span class="text-muted small d-block">Số điện thoại:</span>
                <strong class="text-dark">@Model.CustomerPhone</strong>
            </div>
            @if (!string.IsNullOrEmpty(Model.Note))
            {
                <div class="col-12 border-top pt-2 mt-2">
                    <span class="text-muted small d-block">Ghi chú:</span>
                    <span class="small">@Model.Note</span>
                </div>
            }
        </div>

        <!-- Bảng chi tiết sản phẩm -->
        <div class="table-responsive mb-4">
            <table class="table table-bordered align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Món</th>
                        <th class="text-center" style="width: 70px;">SL</th>
                        <th class="text-end" style="width: 100px;">Size</th>
                        <th>Topping</th>
                        <th class="text-end" style="width: 120px;">Thành tiền</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.OrderItems)
                    {
                        <tr>
                            <td>
                                <strong class="text-dark">@item.ProductNameSnapshot</strong>
                                <div class="small text-muted">@item.UnitPrice.ToString("N0") đ</div>
                            </td>
                            <td class="text-center fw-bold">@item.Quantity</td>
                            <td class="text-end small">
                                @(string.IsNullOrEmpty(item.SizeNameSnapshot) ? "-" : item.SizeNameSnapshot)
                            </td>
                            <td class="small">
                                @if (item.OrderItemToppings != null && item.OrderItemToppings.Any())
                                {
                                    <ul class="mb-0 ps-3">
                                        @foreach (var top in item.OrderItemToppings)
                                        {
                                            <li>@top.ToppingNameSnapshot (+@top.TotalPrice.ToString("N0") đ)</li>
                                        }
                                    </ul>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </td>
                            <td class="text-end fw-bold text-danger">@item.LineTotal.ToString("N0") đ</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Tổng tiền -->
        <div class="row justify-content-end">
            <div class="col-md-6">
                <div class="p-3 bg-light rounded-3">
                    <div class="d-flex justify-content-between mb-2">
                        <span>Tạm tính:</span>
                        <span>@Model.SubTotal.ToString("N0") đ</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span>Giảm giá:</span>
                        <span class="text-success">-@Model.DiscountAmount.ToString("N0") đ</span>
                    </div>
                    <hr class="my-2" />
                    <div class="d-flex justify-content-between align-items-center">
                        <strong class="fs-6">Tổng tiền thanh toán:</strong>
                        <strong class="fs-4 text-danger">@Model.TotalAmount.ToString("N0") đ</strong>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>