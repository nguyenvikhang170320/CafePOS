@model Order

@{
    ViewData["Title"] = "Chi tiết đơn hàng #" + Model.OrderCode;
    Layout = "~/Views/Shared/_Layout.cshtml";

    var orderStatusText = Model.OrderStatus switch
    {
        "Pending" => "Chờ xử lý",
        "Completed" => "Đã hoàn thành",
        "Cancelled" => "Đã hủy",
        _ => Model.OrderStatus
    };

    var orderStatusClass = Model.OrderStatus switch
    {
        "Pending" => "status-warning",
        "Completed" => "status-success",
        "Cancelled" => "status-danger",
        _ => "status-neutral"
    };

    var paymentText = Model.PaymentStatus == "Paid" ? "Đã thanh toán" : "Chưa thanh toán";
    var paymentClass = Model.PaymentStatus == "Paid" ? "status-success" : "status-neutral";

    var paymentMethodText = Model.PaymentMethod switch
    {
        "Cash" => "Tiền mặt",
        "Banking" => "Chuyển khoản / QR",
        "Card" => "Thẻ ngân hàng",
        "VNPAY" => "VNPAY",
        _ => "Chưa xác định"
    };
    var bankId =
    ViewBag.BankId?.ToString() ?? "";

    var accountNumber =
        ViewBag.BankAccountNumber?.ToString() ?? "";

    var accountName =
        ViewBag.BankAccountName?.ToString() ?? "";

    var qrDescription =
        $"CafePOS {Model.OrderCode}";

    var vietQrUrl =
        $"https://img.vietqr.io/image/{bankId}-{accountNumber}-compact2.png" +
        $"?amount={Model.TotalAmount:0}" +
        $"&addInfo={Uri.EscapeDataString(qrDescription)}" +
        $"&accountName={Uri.EscapeDataString(accountName)}";
}

<style>
    .order-detail { --coffee:#6f2f06; --coffee-dark:#4a1d03; --cream:#fffaf5; --line:#eadfd5; --muted:#7b7169; }
    .order-detail .page-title { color:#241b16; font-weight:800; }
    .order-detail .soft-card { border:1px solid var(--line); border-radius:18px; box-shadow:0 8px 24px rgba(67,41,24,.06); }
    .order-detail .summary-head { background:linear-gradient(135deg,#6f2f06,#8b4513); color:#fff; }
    .order-detail .status-pill { display:inline-flex; align-items:center; padding:.4rem .75rem; border-radius:999px; font-size:.78rem; font-weight:700; }
    .order-detail .status-success { background:#e4f4e9; color:#18823b; }
    .order-detail .status-warning { background:#fff1dc; color:#be6a00; }
    .order-detail .status-danger { background:#fde5e4; color:#c63e36; }
    .order-detail .status-neutral { background:#f1efed; color:#6f655e; }
    .order-detail .info-row { display:flex; justify-content:space-between; gap:20px; padding:.55rem 0; }
    .order-detail .info-row + .info-row { border-top:1px dashed #eee5de; }
    .order-detail .label { color:var(--muted); font-size:.87rem; }
    .order-detail .value { font-weight:700; text-align:right; color:#2c221d; }
    .order-detail .items-table thead th { font-size:.78rem; text-transform:uppercase; letter-spacing:.03em; color:#756a62; background:#faf7f4; white-space:nowrap; }
    .order-detail .total-box { background:#fff8f1; border:1px solid #ead9ca; border-radius:16px; }
    .order-detail .back-btn { border-color:#ddd1c7; color:#51463f; }
    @@media (max-width: 767.98px) {
        .order-detail .items-table { min-width:760px; }
        .order-detail .page-title { font-size:1.25rem; }
    }
</style>

<div class="container py-4 order-detail">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <a asp-action="MyOrders" class="btn btn-sm rounded-circle back-btn d-inline-flex align-items-center justify-content-center" style="width:38px;height:38px;">
                    ←
                </a>
                <h3 class="page-title mb-0">Chi tiết đơn hàng</h3>
            </div>
            <p class="text-muted mb-0 ms-5 small">#@Model.OrderCode · @Model.CreatedDate.ToString("dd/MM/yyyy HH:mm")</p>
        </div>
        <a asp-action="Invoice" asp-route-phone="@Model.CustomerPhone" class="btn btn-outline-dark rounded-pill px-4">
            Xem hóa đơn
        </a>
    </div>

    <div class="row g-4">
        <div class="col-lg-8">
            <div class="soft-card bg-white overflow-hidden">
                <div class="summary-head p-4 d-flex flex-wrap justify-content-between align-items-center gap-3">
                    <div>
                        <div class="small text-white-50 mb-1">Mã đơn hàng</div>
                        <div class="fw-bold fs-5">#@Model.OrderCode</div>
                    </div>
                    <div class="d-flex gap-2 flex-wrap">
                        <span class="status-pill @orderStatusClass">@orderStatusText</span>
                        <span class="status-pill @paymentClass">@paymentText</span>
                    </div>
                </div>

                <div class="p-4 pb-2">
                    <h5 class="fw-bold mb-1">Món đã đặt</h5>
                    <p class="text-muted small mb-0">@(Model.OrderItems?.Count() ?? 0) món trong đơn</p>
                </div>

                <div class="table-responsive">
                    <table class="table align-middle mb-0 items-table">
                        <thead>
                            <tr>
                                <th class="ps-4">Tên món</th>
                                <th>Size</th>
                                <th class="text-center">SL</th>
                                <th class="text-end">Đơn giá</th>
                                <th>Topping</th>
                                <th class="text-end pe-4">Thành tiền</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.OrderItems != null && Model.OrderItems.Any())
                            {
                                foreach (var item in Model.OrderItems)
                                {
                                    <tr>
                                        <td class="ps-4">
                                            <div class="fw-bold text-dark">@item.ProductNameSnapshot</div>
                                            @if (!string.IsNullOrWhiteSpace(item.ItemNote))
                                            {
                                                <div class="small text-muted mt-1">Ghi chú: @item.ItemNote</div>
                                            }
                                        </td>
                                        <td>
                                            <span class="badge bg-light text-dark border">
                                                @(string.IsNullOrWhiteSpace(item.SizeNameSnapshot) ? "Mặc định" : item.SizeNameSnapshot)
                                            </span>
                                        </td>
                                        <td class="text-center fw-bold">@item.Quantity</td>
                                        <td class="text-end">@item.UnitPrice.ToString("N0") đ</td>
                                        <td>
                                            @if (item.OrderItemToppings != null && item.OrderItemToppings.Any())
                                            {
                                                <div class="d-flex flex-wrap gap-1">
                                                    @foreach (var top in item.OrderItemToppings)
                                                    {
                                                        <span class="badge bg-light text-dark border fw-normal">
                                                            + @top.ToppingNameSnapshot x@top.Quantity
                                                        </span>
                                                    }
                                                </div>
                                            }
                                            else
                                            {
                                                <span class="text-muted small">Không</span>
                                            }
                                        </td>
                                        <td class="text-end pe-4 fw-bold text-danger">@item.LineTotal.ToString("N0") đ</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="6" class="text-center text-muted py-5">Không có thông tin món.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="soft-card bg-white p-4 mb-4">
                <h5 class="fw-bold mb-3">Thông tin đơn hàng</h5>

                <div class="info-row">
                    <span class="label">Khách hàng</span>
                    <span class="value">@(string.IsNullOrWhiteSpace(Model.CustomerName) ? "Khách hàng" : Model.CustomerName)</span>
                </div>
                <div class="info-row">
                    <span class="label">Số điện thoại</span>
                    <span class="value">@(string.IsNullOrWhiteSpace(Model.CustomerPhone) ? "—" : Model.CustomerPhone)</span>
                </div>
                <div class="info-row">
                    <span class="label">Trạng thái đơn</span>
                    <span class="status-pill @orderStatusClass">@orderStatusText</span>
                </div>
                <div class="info-row">
                    <span class="label">Thanh toán</span>
                    <span class="status-pill @paymentClass">@paymentText</span>
                </div>
                <div class="info-row">
                    <span class="label">Phương thức</span>
                    <span class="value">@paymentMethodText</span>
                </div>

                @if (!string.IsNullOrWhiteSpace(Model.Note))
                {
                    <div class="mt-3 p-3 bg-light rounded-3">
                        <div class="text-muted small fw-semibold mb-1">Ghi chú</div>
                        <div class="small">@Model.Note</div>
                    </div>
                }
            </div>
            @if (Model.PaymentMethod == "Banking" && Model.PaymentStatus != "Paid")
            {
                <div class="soft-card bg-white p-4 mb-4">

                    <div class="text-center">

                        <h5 class="fw-bold mb-2">
                            <i class="bi bi-qr-code-scan me-2"></i>
                            Quét QR chuyển khoản
                        </h5>

                        <p class="text-muted small mb-3">
                            Quét mã QR bên dưới để thanh toán đơn hàng.
                        </p>

                        @if (
                            !string.IsNullOrWhiteSpace(bankId)
                            &&
                            !string.IsNullOrWhiteSpace(accountNumber)
                        )
                        {
                            <img src="@vietQrUrl"
                                 alt="VietQR"
                                 class="img-fluid rounded-3 border bg-white p-2"
                                 style="max-width:300px;" />

                            <div class="mt-3">

                                <div class="fw-bold">
                                    @accountName
                                </div>

                                <div class="text-muted small">
                                    STK: @accountNumber
                                </div>

                                <div class="fw-bold text-danger fs-4 mt-2">
                                    @Model.TotalAmount.ToString("N0") đ
                                </div>

                                <div class="small text-muted mt-2">
                                    Nội dung:
                                    <strong>@qrDescription</strong>
                                </div>

                            </div>

                            <div class="alert alert-warning border-0 rounded-4 mt-3 mb-0 text-start">
                                <i class="bi bi-info-circle-fill me-1"></i>

                                Sau khi chuyển khoản, vui lòng chờ quán xác nhận
                                tiền đã vào tài khoản.
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-danger mb-0">
                                Chưa cấu hình thông tin ngân hàng để tạo VietQR.
                            </div>
                        }

                    </div>

                </div>
            }
            else if (
                Model.PaymentMethod == "Banking"
                &&
                Model.PaymentStatus == "Paid"
            )
            {
                <div class="alert alert-success rounded-4 border-0 mb-4">

                    <i class="bi bi-check-circle-fill me-2"></i>

                    Quán đã xác nhận thanh toán chuyển khoản thành công.

                </div>
            }
            else if (
                Model.PaymentMethod == "Cash"
                &&
                Model.PaymentStatus != "Paid"
            )
            {
                <div class="alert alert-light border rounded-4 mb-4">

                    <i class="bi bi-cash me-2"></i>

                    Bạn sẽ thanh toán bằng
                    <strong>tiền mặt khi nhận hàng</strong>.

                </div>
            }

            <div class="total-box p-4">
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted">Tạm tính</span>
                    <span>@Model.SubTotal.ToString("N0") đ</span>
                </div>
                <div class="d-flex justify-content-between mb-3">
                    <span class="text-muted">Giảm giá</span>
                    <span class="text-success">-@Model.DiscountAmount.ToString("N0") đ</span>
                </div>
                <div class="border-top pt-3 d-flex justify-content-between align-items-end">
                    <span class="fw-bold">Tổng thanh toán</span>
                    <span class="fw-bold text-danger fs-4">@Model.TotalAmount.ToString("N0") đ</span>
                </div>
            </div>
        </div>
    </div>
</div>
