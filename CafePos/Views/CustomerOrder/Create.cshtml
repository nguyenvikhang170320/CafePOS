@using CafePos.Models
@{
    ViewData["Title"] = "Đặt món Online";
    var products = ViewBag.Products as List<Product> ?? new List<Product>();
    var toppings = ViewBag.Toppings as List<Topping> ?? new List<Topping>();
}

<form asp-action="Create" method="post">
    @Html.AntiForgeryToken()

    <!-- Thông tin người nhận -->
    <div class="row mb-3">
        <div class="col-md-6 mb-3 mb-md-0">
            <label class="form-label fw-bold">Tên người đặt</label>
            <input type="text" class="form-control" value="@ViewBag.CustomerName" readonly />
        </div>
        <div class="col-md-6">
            <label class="form-label fw-bold">Số điện thoại nhận hàng <span class="text-danger">*</span></label>
            <input type="text" name="phone" class="form-control" value="@ViewBag.CustomerPhone" placeholder="Nhập số điện thoại nhận hàng" required />
        </div>
    </div>

    <div class="mb-4">
        <label class="form-label fw-bold">Ghi chú giao hàng / Địa chỉ</label>
        <textarea name="note" class="form-control" rows="2" placeholder="Ví dụ: Giao ít đá, số nhà 123..."></textarea>
    </div>

    <h5 class="fw-bold mb-3">📋 Danh sách món</h5>
    <div class="table-responsive mb-3">
        <table class="table table-bordered align-middle">
            <thead class="table-light">
                <tr>
                    <th>Tên món & Topping</th>
                    <th style="width: 120px;">Đơn giá</th>
                    <th style="width: 180px;">Chọn Size</th>
                    <th style="width: 110px;">Số lượng</th>
                    <th style="width: 140px;" class="text-end">Thành tiền</th>
                </tr>
            </thead>
            <tbody>
                @if (products.Any())
                {
                    for (int i = 0; i < products.Count; i++)
                    {
                        var item = products[i];
                        var sizes = item.ProductSizes?.Where(s => !s.IsDeleted).ToList() ?? new List<ProductSize>();

                        <tr class="product-row">
                            <td>
                                <input type="hidden" name="productIds" value="@item.ProductId" />
                                <strong class="text-primary fs-6">@item.Name</strong>

                                <!-- 🌟 TOPPING RIÊNG CHO TỪNG MÓN -->
                                @if (toppings.Any())
                                {
                                    <div class="mt-2 pt-2 border-top">
                                        <small class="fw-bold text-muted d-block mb-1">Thêm Topping:</small>
                                        <div class="d-flex flex-wrap gap-2">
                                            @foreach (var top in toppings)
                                            {
                                                <div class="form-check form-check-inline me-2 mb-1">
                                                    <!-- Đặt name dạng array để Controller nhận đúng theo từng món: itemToppings[i] -->
                                                    <input class="form-check-input topping-checkbox"
                                                           type="checkbox"
                                                           name="itemToppings_@i"
                                                           value="@top.ToppingId"
                                                           data-price="@top.Price"
                                                           id="top_@(i)_@top.ToppingId">
                                                    <label class="form-check-label small" for="top_@(i)_@top.ToppingId">
                                                        @top.Name <span class="text-danger">(+@top.Price.ToString("N0")đ)</span>
                                                    </label>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                }
                            </td>
                            <td>
                                <span class="unit-price text-muted" data-base-price="@item.BasePrice">
                                    @item.BasePrice.ToString("N0") đ
                                </span>
                            </td>
                            <td>
                                @if (sizes.Any())
                                {
                                    <select name="productSizeIds" class="form-select form-select-sm size-select">
                                        <option value="" data-extra-price="0">Size M (Mặc định)</option>
                                        @foreach (var s in sizes)
                                        {
                                            <option value="@s.ProductSizeId" data-extra-price="@s.ExtraPrice">
                                                Size @s.SizeName (+@s.ExtraPrice.ToString("N0") đ)
                                            </option>
                                        }
                                    </select>
                                }
                                else
                                {
                                    <input type="hidden" name="productSizeIds" value="" />
                                    <span class="text-muted small">N/A</span>
                                }
                            </td>
                            <td>
                                <input type="number"
                                       name="quantities"
                                       class="form-control form-control-sm text-center quantity-input"
                                       value="0"
                                       min="0"
                                       max="99" />
                            </td>
                            <td class="text-end">
                                <span class="line-total text-danger fw-bold">0 đ</span>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <!-- DÒNG TỔNG CỘNG TIỀN ĐƠN HÀNG -->
    <div class="card bg-light border-0 p-3 mb-4 rounded-3 text-end shadow-sm">
        <div class="fs-5">
            Tổng tiền món: <strong id="grandTotal" class="text-danger fs-4">0 đ</strong>
        </div>
    </div>

    <button type="submit" class="btn btn-success btn-lg w-100 font-weight-bold shadow-sm">
        🛒 Đặt Món Ngay
    </button>
</form>

<script>
    document.addEventListener("DOMContentLoaded", function() {

        function calculateRowAndTotal() {
            let grandTotal = 0;

            document.querySelectorAll(".product-row").forEach(function(row) {
                let unitPriceEl = row.querySelector(".unit-price");
                let basePrice = parseFloat(unitPriceEl.getAttribute("data-base-price")) || 0;

                // Giá Size
                let extraPrice = 0;
                let sizeSelect = row.querySelector(".size-select");
                if (sizeSelect) {
                    let selectedOption = sizeSelect.options[sizeSelect.selectedIndex];
                    extraPrice = parseFloat(selectedOption.getAttribute("data-extra-price")) || 0;
                }

                // Số lượng
                let quantityInput = row.querySelector(".quantity-input");
                let quantity = parseInt(quantityInput.value) || 0;

                // Tính tiền Topping của RIÊNG MÓN NÀY
                let toppingTotalPerUnit = 0;
                row.querySelectorAll(".topping-checkbox:checked").forEach(function(topCb) {
                    toppingTotalPerUnit += parseFloat(topCb.getAttribute("data-price")) || 0;
                });

                // Thành tiền món = (Giá gốc + Size + Toppings) * Số lượng
                let lineTotal = 0;
                if (quantity > 0) {
                    lineTotal = (basePrice + extraPrice + toppingTotalPerUnit) * quantity;
                }

                let lineTotalEl = row.querySelector(".line-total");
                if (lineTotalEl) {
                    lineTotalEl.textContent = lineTotal.toLocaleString('vi-VN') + " đ";
                }

                grandTotal += lineTotal;
            });

            let grandTotalEl = document.getElementById("grandTotal");
            if (grandTotalEl) {
                grandTotalEl.textContent = grandTotal.toLocaleString('vi-VN') + " đ";
            }
        }

        // Bắt sự kiện thay đổi
        document.querySelectorAll(".size-select, .quantity-input, .topping-checkbox").forEach(function(el) {
            el.addEventListener("change", calculateRowAndTotal);
            el.addEventListener("input", calculateRowAndTotal);
        });

    });
</script>