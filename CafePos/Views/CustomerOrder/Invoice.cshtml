@model IEnumerable<Order>

@{
    ViewData["Title"] = "Hóa đơn điện tử";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold mb-1">📄 Hóa đơn của tôi</h3>
            <p class="text-muted mb-0 small">Chọn một hóa đơn từ danh sách để xem chi tiết.</p>
        </div>
        <a asp-action="MyOrders" class="btn btn-outline-secondary rounded-pill px-4">
            ⬅️ Quay lại Đơn của tôi
        </a>
    </div>

    <div class="row g-4">
        <!-- Danh sách hóa đơn bên trái -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                <div class="card-header bg-white fw-bold py-3">Danh sách hóa đơn</div>
                <div class="list-group list-group-flush" style="max-height: 65vh; overflow-y: auto;">
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <button type="button"
                                    class="list-group-item list-group-item-action p-3 customer-invoice-item border-bottom"
                                    data-id="@item.OrderId">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <span class="fw-bold text-primary">#@item.OrderCode</span>
                                    <span class="text-danger fw-bold">@item.TotalAmount.ToString("N0") đ</span>
                                </div>
                                <div class="d-flex justify-content-between align-items-center">
                                    <small class="text-muted">@item.CreatedDate.ToString("dd/MM/yyyy HH:mm")</small>
                                    <small class="badge bg-light text-dark border">@item.OrderStatus</small>
                                </div>
                            </button>
                        }
                    }
                    else
                    {
                        <div class="p-4 text-center text-muted">Không có hóa đơn nào.</div>
                    }
                </div>
            </div>
        </div>

        <!-- Vùng hiển thị chi tiết hóa đơn bên phải -->
        <div class="col-lg-8">
            <div id="customerInvoiceDetail">
                <div class="card border-0 shadow-sm rounded-4 text-center py-5">
                    <div class="card-body">
                        <div class="fs-1 text-muted mb-2">📑</div>
                        <h5 class="text-muted">Vui lòng chọn một hóa đơn bên trái để xem thông tin chi tiết.</h5>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            $(".customer-invoice-item").click(function() {
                $(".customer-invoice-item").removeClass("active bg-light");
                $(this).addClass("active bg-light");

                let id = $(this).data("id");
                $("#customerInvoiceDetail").html("<div class='card border-0 shadow-sm rounded-4 text-center py-5'><div class='spinner-border text-primary mx-auto mb-2'></div><div>Đang tải hóa đơn...</div></div>");

                $.ajax({
                    url: '@Url.Action("GetInvoicePartial", "CustomerOrder")',
                    type: 'GET',
                    data: { id: id },
                    success: function(res) {
                        $("#customerInvoiceDetail").html(res);
                    },
                    error: function() {
                        $("#customerInvoiceDetail").html("<div class='alert alert-danger rounded-4'>Không thể tải hóa đơn này.</div>");
                    }
                });
            });
        });
    </script>
}