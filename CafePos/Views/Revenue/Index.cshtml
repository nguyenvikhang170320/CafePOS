@model CafePos.Models.ViewModels.ShiftReportViewModel

@{
    ViewData["Title"] = "Báo cáo ca làm việc";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var employeeId = ViewBag.EmployeeId;
    var positionName = ViewBag.PositionName?.ToString() ?? "";
    var transactionCount =
        ViewBag.TransactionCount != null
            ? Convert.ToInt32(ViewBag.TransactionCount)
            : 0;
}

<div class="container py-4">

    <!-- ========================================================= -->
    <!-- HEADER -->
    <!-- ========================================================= -->

    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">

        <div>

            <h2 class="fw-bold mb-1">
                Báo cáo ca làm việc
            </h2>

            <p class="text-muted mb-0">

                Ngày:
                <strong>
                    @Model.ReportDate.ToString("dd/MM/yyyy")
                </strong>

                <span class="mx-1">|</span>

                Nhân viên:
                <strong>
                    @Model.EmployeeName
                </strong>

            </p>

        </div>


        <button type="button"
                onclick="window.print()"
                class="btn btn-outline-secondary d-print-none">

            <i class="bi bi-printer me-1"></i>
            In báo cáo kết ca

        </button>

    </div>


    <!-- ========================================================= -->
    <!-- THÔNG BÁO -->
    <!-- ========================================================= -->

    <div class="alert alert-light border rounded-4 mb-4">

        <i class="bi bi-info-circle-fill text-primary me-2"></i>

        Báo cáo này hiển thị
        <strong>
            các khoản tiền do chính nhân viên này thực hiện thu
        </strong>
        trong ngày.

    </div>


    <!-- ========================================================= -->
    <!-- KPI -->
    <!-- ========================================================= -->

    <div class="row g-3 mb-4">


        <div class="col-md-6 col-xl-3">

            <div class="card border-0 shadow-sm rounded-4 bg-primary text-white h-100">

                <div class="card-body">

                    <h6 class="opacity-75">
                        Tổng tiền đã thu
                    </h6>

                    <h3 class="fw-bold mb-0">
                        @Model.TotalRevenue.ToString("N0") đ
                    </h3>

                </div>

            </div>

        </div>


        <div class="col-md-6 col-xl-3">

            <div class="card border-0 shadow-sm rounded-4 bg-success text-white h-100">

                <div class="card-body">

                    <h6 class="opacity-75">
                        Tiền mặt đã thu
                    </h6>

                    <h3 class="fw-bold mb-0">
                        @Model.CashRevenue.ToString("N0") đ
                    </h3>

                </div>

            </div>

        </div>


        <div class="col-md-6 col-xl-3">

            <div class="card border-0 shadow-sm rounded-4 bg-info text-white h-100">

                <div class="card-body">

                    <h6 class="opacity-75">
                        Chuyển khoản / App
                    </h6>

                    <h3 class="fw-bold mb-0">
                        @Model.BankTransferRevenue.ToString("N0") đ
                    </h3>

                </div>

            </div>

        </div>


        <div class="col-md-6 col-xl-3">

            <div class="card border-0 shadow-sm rounded-4 bg-dark text-white h-100">

                <div class="card-body">

                    <h6 class="opacity-75">
                        Số đơn đã thu
                    </h6>

                    <h3 class="fw-bold mb-0">
                        @Model.TotalOrders đơn
                    </h3>

                </div>

            </div>

        </div>

    </div>


    <!-- ========================================================= -->
    <!-- THÔNG TIN GIAO DỊCH -->
    <!-- ========================================================= -->

    <div class="row g-3 mb-4">


        <div class="col-md-6">

            <div class="card border-0 shadow-sm rounded-4 h-100">

                <div class="card-body">

                    <div class="text-muted small mb-1">
                        Tổng số giao dịch
                    </div>

                    <div class="fw-bold fs-4">
                        @transactionCount
                    </div>

                </div>

            </div>

        </div>


        <div class="col-md-6">

            <div class="card border-0 shadow-sm rounded-4 h-100">

                <div class="card-body">

                    <div class="text-muted small mb-1">
                        Chức vụ
                    </div>

                    <div class="fw-bold fs-5">

                        @(
                            string.IsNullOrWhiteSpace(positionName)
                                ? "Nhân viên"
                                : positionName
                        )

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- ========================================================= -->
    <!-- DANH SÁCH ĐƠN ĐÃ THU -->
    <!-- ========================================================= -->

    <div class="card border-0 shadow-sm rounded-4">

        <div class="card-body">

            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">

                <h5 class="fw-bold mb-0">

                    <i class="bi bi-receipt text-primary me-2"></i>
                    Các đơn tôi đã thu tiền hôm nay

                </h5>

                <span class="badge bg-primary rounded-pill px-3 py-2">
                    @Model.TotalOrders đơn
                </span>

            </div>


            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">

                        <tr>
                            <th>Mã đơn</th>
                            <th>Thời điểm thu</th>
                            <th>Phương thức</th>
                            <th>Trạng thái</th>
                            <th class="text-end">
                                Số tiền tôi đã thu
                            </th>
                        </tr>

                    </thead>


                    <tbody>

                        @if (
                            Model.TodayOrders != null &&
                            Model.TodayOrders.Any()
                        )
                        {
                            foreach (var order in Model.TodayOrders)
                            {
                                var isCash =
                                    string.Equals(
                                        order.PaymentMethod,
                                        "Cash",
                                        StringComparison.OrdinalIgnoreCase
                                    )
                                    ||
                                    string.Equals(
                                        order.PaymentMethod,
                                        "Tiền mặt",
                                        StringComparison.OrdinalIgnoreCase
                                    );

                                <tr>

                                    <td>

                                        <strong>
                                            #@order.OrderId
                                        </strong>

                                    </td>


                                    <td>

                                        @order.CreatedDate.ToString("HH:mm")

                                    </td>


                                    <td>

                                        <span class="badge @(isCash ? "bg-success" : "bg-info")">

                                            @order.PaymentMethod

                                        </span>

                                    </td>


                                    <td>

                                        @if (order.OrderStatus == "Completed")
                                        {
                                            <span class="badge bg-success">

                                                <i class="bi bi-check-circle me-1"></i>
                                                Hoàn thành

                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">

                                                @order.OrderStatus

                                            </span>
                                        }

                                    </td>


                                    <td class="text-end fw-bold text-primary">

                                        @order.TotalAmount.ToString("N0") đ

                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>

                                <td colspan="5"
                                    class="text-center text-muted py-5">

                                    <i class="bi bi-inbox fs-2 d-block mb-2"></i>

                                    Hôm nay bạn chưa thực hiện
                                    giao dịch thanh toán nào.

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>